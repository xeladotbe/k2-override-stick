[gcode_macro USER_CONFIG]
# ============================================================================
# Your own settings. Save this file as 00_user_config.cfg (without .example)
# next to the other .cfg files, then uncomment and adjust what you need.
#
# Only list what you want to change: everything else keeps its value from
# 00_defaults.cfg. A setting you list replaces its default COMPLETELY, so when
# you give it per material, keep a 'default' entry for all other materials.
#
# To use an example, remove the "# " (hash and one space) at the start of its
# lines. The setting's name must then start at the very beginning of the line,
# and every further line of it, the closing } included, must stay indented,
# or Klipper doesn't start. Numbers use a dot.
#
# ---------------------------------------------------------------------------
# Three ways to write a setting
# ---------------------------------------------------------------------------
#
# 1. One number for everything:
#
# variable_soak_minutes: 5
#
# 2. Per material. Material names in UPPER CASE, as the slicer's filament
#    type; 'default' covers every other material:
#
# variable_soak_minutes: {
#     'default': 5,
#     'ABS': 10,
#     'ASA': 10,
#     }
#
# 3. Per material and build plate. Plate names exactly as the slicer calls
#    them (upper/lower case matters). A plate that isn't listed uses the
#    material's 'default', else the outer 'default':
#
# variable_z_offset: {
#     'default': 0.05,
#     'PETG': {'Textured PEI Plate': 0.02, 'default': 0.03},
#     'PLA': {'High Temp Plate': 0.04, 'Textured PEI Plate': 0.06, 'default': 0.05},
#     }
#
#    The outer 'default' can be per plate as well. Then give it its own
#    'default', or plates it doesn't list get 0:
#
# variable_z_offset: {
#     'default': {'High Temp Plate': 0.045, 'default': 0},
#     'PETG': {'High Temp Plate': 0.007, 'default': 0},
#     }
#
# ---------------------------------------------------------------------------
# All settings (default in brackets); each works in all three ways above
# ---------------------------------------------------------------------------
#
# variable_z_offset                  [0]
#   Z-offset in mm, applied at the end of the start sequence.
#   Larger = nozzle farther from the bed.
#
# variable_min_z_offset              [-0.05]
#   Lowest Z-offset ever applied: K2_FILAMENT_Z_OFFSET clamps to it, and the
#   mesh check measures again instead of shifting the Z-offset below it.
#
# variable_soak_minutes             [5, ABS 10]
#   Heat soak once the bed has reached its temperature. 0 = no soak.
#   The print is paused meanwhile; cancel or resume works any time.
#
# variable_small_print_coverage_pct  [0, PLA 15]
#   A print is "small" if its objects cover less than this % of the bed.
#   0 = never small. Small prints skip the soak.
#
# variable_small_print_adaptive_mesh [1]
#   Small prints: 1 = probe only around the print (no cache),
#   0 = use the cached full-bed mesh.
#
# variable_mesh_check_tolerance      [0.025]
#   Before a cached mesh is used, a few of its points are probed. If they
#   differ by more than this (mm) on average, or one point by more than
#   mesh_check_point_factor times that, the bed is measured again.
#   0 = load without checking.
#
# variable_mesh_check_point_factor   [1]
#   How far a single probed point may be off, as a multiple of
#   mesh_check_tolerance (e.g. 1.5 or 2 = more lenient).
#
# variable_mesh_check_shape_tolerance [0.025]
#   If the probed points are only shifted (each within this of their mean),
#   the cached mesh is used and the shift added to the Z-offset, unless the
#   Z-offset would go below min_z_offset (then the bed is measured again).
#   0 = always measure again.
#
# variable_mesh_max_uses             [20]
#   Measure a cached mesh again after this many prints used it. 0 = never.
#
# variable_mesh_stable_tolerance     [0.03]
#   A fresh mesh must read about 0 in the bed's middle (where Z was just
#   homed), and the middle probed again after the mesh may differ by at most
#   this. Otherwise the bed was still moving: the print uses that mesh, but
#   it isn't cached. 0 = no check.
#
# variable_mesh_drift_correction    [0.5]
#   Part of that measured movement put onto this print's Z-offset (the
#   middle is probed first and printed last). 0.5 = half, 0 = off.
#
# variable_soak_stable_mm_per_min   [0]
#   Dynamic soak: > 0 probes the bed middle every minute and starts as soon
#   as it rises at most this many mm/min (soak_minutes is then the maximum).
#   Some beds look quiet at first and deform later; K2_TUNE checks yours.
#   0 = always the full soak_minutes.
#
# variable_tune_profile             ['good']
#   'good' or 'best': soak_minutes and the mesh_* tolerances come from the
#   K2_TUNE result for the print's bed temperature (none: the values here,
#   K2_STATUS lists the temperatures to run K2_TUNE for). One value for all
#   prints, not per material.
#
# For a single print, K2_<SETTING>=<number> on the slicer's START_PRINT line
# wins over this file, e.g. K2_Z_OFFSET_PETG=0.02 (README: "Per-print overrides").
# ============================================================================

gcode:

# ============================================================================
# Other Klipper sections
# ============================================================================
# This file is included after Creality's printer.cfg, so a section here
# overrides single options of the stock one. Example: Z_TILT_ADJUST (runs after
# every Klipper restart and in G29) accepts up to 0.1 mm left/right difference
# by default; a tighter value re-aligns more precisely. Not below ~0.04: the
# probe scatters about +-0.02, and after 10 failed retries Z_TILT_ADJUST
# aborts with an error (and with it G29 or the print start).
#
# [z_tilt]
# retry_tolerance: 0.05
